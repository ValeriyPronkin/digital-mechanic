# Скопируйте в .env и заполните. .env в git не попадает (gitleaks проверяет).
# Порт сервиса для make run / docker compose.
# PORT=8000
# GigaChat: ключ авторизации (base64) из developers.sber.ru; сертификат Минцифры уже в src/service/certs/.
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# DEEPSEEK_API_KEY=

# Заглушки заказчика (запуск — vendor/neurodvs_mock/README.md)
MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
# Провайдер модели: deepseek | gigachat
LLM_PROVIDER=deepseek
# Yandex AI Studio: эмбеддинги, OCR
# YANDEX_API_KEY=
# Каталог Yandex Cloud, к которому привязан ключ (нужен для эмбеддингов и OCR)
# YANDEX_FOLDER_ID=
# Где лежит собранный индекс руководств (make index)
# INDEX_DIR=.index
# Голос (#14): ключ SpeechKit (иначе берётся YANDEX_API_KEY); голос и скорость синтеза — D-14, issue #18
# YANDEX_TTS_API_KEY=
# TTS_VOICE=filipp
# TTS_SPEED=0.95
# Цены голоса для журнала расходов, ₽ (допущение — сверить с прайсом SpeechKit)
# STT_PRICE_RUB_PER_15S=0.16
# TTS_PRICE_RUB_PER_1K_CHARS=1.32
# Частный бакет Object Storage с индексом и PDF (D-9, #6). Ключ — только локально для make kb-publish;
# стенд читает бакет по IAM-токену своего сервисного аккаунта, ключ туда не кладём.
# S3_BUCKET=digital-mechanic-kb
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Каталог с PDF руководств (в git не входят)
MANUALS_DIR=./manuals
# Модель провайдера (по умолчанию deepseek-chat / GigaChat-2-Max)
# LLM_MODEL=
# Лимиты расходов на модель, ₽ (D-11): в сутки по Москве и всего; проверяются до каждого вызова по журналу
LLM_BUDGET_DAY_RUB=100
LLM_BUDGET_TOTAL_RUB=1000
# Цены, ₽ за 1 млн токенов (вход / выход). Пусто — значения по умолчанию из src/service/store.py
LLM_PRICE_IN_RUB=25
LLM_PRICE_OUT_RUB=100
# Журнал токенов и память по ТС (SQLite)
# STATE_DB=.state/agent.db
